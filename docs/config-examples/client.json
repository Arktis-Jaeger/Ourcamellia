{
  "mode": "auto",
  "dataDir": "~/.ourcamellia",
  "defaultRecording": true,
  "discoverable": true,
  "connectable": true,
  "listenHost": "0.0.0.0",
  "listenPort": 54536,
  "discoveryPort": 54535,
  "discoveryTtlSeconds": 60,
  "connectTimeoutMs": 10000,
  "readTimeoutMs": 90000,
